# Studio CMS. Copy to .env, set STUDIO_DOMAIN, then run: docker compose up -d
# Every other setting has a default. Full list: handbook, "Settings".
# The version comes with compose.yaml. To update: unpack the zip of the new version
# here (unzip -o), then docker compose up -d. To hold a version: STUDIO_VERSION=<version>

# Services: proxy (HTTPS with Let's Encrypt, also for project websites on this server),
# build (builds websites on this server).
COMPOSE_PROFILES=proxy,build

# Address of the Studio. Its DNS record must point to this server. Required.
STUDIO_DOMAIN=

# --- Optional. Uncomment to override the default. ---
# Base domain for websites (<project>.<this>), not sharing the Studio's. Default: none.
# STUDIO_SITES_DOMAIN=agency-sites.example

# Open domain for forms, booking, statistics and preview links. Default: STUDIO_DOMAIN.
# STUDIO_PUBLIC_DOMAIN=forms.agency.example

# Contact address for Let's Encrypt. Default: none.
# STUDIO_ACME_EMAIL=ops@agency.example

# CDN or proxy in front of this server (comma-separated CIDR list). Default: none.
# STUDIO_UPSTREAM_PROXY_IPS=203.0.113.0/24

# Where data and backups live. Default: ./data and ./backups
# STUDIO_DATA_DIR=/mnt/data/studio
# STUDIO_BACKUP_DIR=/mnt/backup/studio

# Encrypted off-site backup with restic, on once RESTIC_REPOSITORY is set. The target must
# only accept new data (append-only); otherwise also set STUDIO_BACKUP_PROTECTION=none.
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=

# Restored or test copy: add STUDIO_COPY_MODE=true, then it sends nothing out
# (no e-mail, no upload to web servers, no off-site backup).

# Secrets are generated into data/secrets/studio.env (part of every backup). Set one
# only from the recovery kit: STUDIO_COOKIE_SECRET, STUDIO_INTERNAL_SECRET, STUDIO_SEAL_KEYS
